{
  "swagger": "2.0",
  "info": {
    "title": "Sunny Personal AI Agent",
    "description": "Coding / Azure DevOps / GitHub gate backend for Teams. Call PersonalAIAgent for repo work; return reply verbatim. Supports optional file attachments for Doc Upload (SharePoint + ingest).",
    "version": "1.0.7"
  },
  "host": "whatsapp-ai-agent-sunny.azurewebsites.net",
  "basePath": "/",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "securityDefinitions": {
    "api_key": {
      "type": "apiKey",
      "in": "header",
      "name": "X-Copilot-Api-Key"
    }
  },
  "security": [
    {
      "api_key": []
    }
  ],
  "paths": {
    "/api/channels/copilot/message": {
      "post": {
        "operationId": "PersonalAIAgent",
        "summary": "PersonalAIAgent",
        "description": "Call for check my repos, Proceed, APPROVE, FIX TESTS, stop, status, and coding or deploy gates. For Teams file upload + ingest, pass attachments[] with base64 content. Show the reply field to the user as-is.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CopilotMessageRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/CopilotMessageResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "CopilotAttachment": {
      "type": "object",
      "required": ["filename"],
      "properties": {
        "filename": {
          "type": "string",
          "x-ms-summary": "Filename",
          "description": "Original file name including extension (e.g. report.pdf)"
        },
        "content_base64": {
          "type": "string",
          "x-ms-summary": "Content Base64",
          "description": "Base64-encoded file bytes from Teams chat attachment"
        },
        "content_url": {
          "type": "string",
          "x-ms-summary": "Content URL",
          "description": "Optional HTTPS URL to download attachment bytes when base64 is not available"
        },
        "content_type": {
          "type": "string",
          "x-ms-summary": "Content Type",
          "description": "MIME type when known (e.g. application/pdf)"
        }
      }
    },
    "CopilotMessageRequest": {
      "type": "object",
      "required": ["user_id", "message"],
      "properties": {
        "user_id": {
          "type": "string",
          "x-ms-summary": "User Id",
          "description": "Signed-in Microsoft Entra object ID"
        },
        "message": {
          "type": "string",
          "x-ms-summary": "Message",
          "description": "Exact user message text (e.g. ingest this attached pdf)"
        },
        "conversation_id": {
          "type": "string",
          "x-ms-summary": "Conversation Id",
          "description": "Optional Teams conversation id for correlation"
        },
        "display_name": {
          "type": "string",
          "x-ms-summary": "Display Name",
          "description": "Signed-in user display name"
        },
        "action": {
          "type": "string",
          "x-ms-summary": "Action",
          "description": "message or status or poll",
          "default": "message"
        },
        "attachments": {
          "type": "array",
          "x-ms-summary": "Attachments",
          "description": "Optional Teams chat files for Doc Upload Agent (SharePoint + ingest)",
          "items": {
            "$ref": "#/definitions/CopilotAttachment"
          }
        }
      }
    },
    "CopilotMessageResponse": {
      "type": "object",
      "required": ["reply"],
      "properties": {
        "reply": {
          "type": "string",
          "x-ms-summary": "Reply",
          "description": "Markdown text to show the user verbatim (Teams-optimized for help/hello)"
        },
        "adaptive_card": {
          "type": "object",
          "x-ms-summary": "Adaptive Card",
          "description": "Optional Adaptive Card JSON for Hello/Help. Prefer rendering this in Teams when present; otherwise show reply."
        },
        "awaiting": {
          "type": "string",
          "x-ms-summary": "Awaiting",
          "description": "Current gate name if any"
        },
        "task_id": {
          "type": "string",
          "x-ms-summary": "Task Id",
          "description": "Pending task id if any"
        }
      }
    }
  }
}
