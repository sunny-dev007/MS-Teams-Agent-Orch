# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# WhatsApp (Meta Cloud API)
WHATSAPP_VERIFY_TOKEN=your-random-verify-token
# IMPORTANT: Do NOT use the temporary ~24h token from Meta API Setup.
# Use a Business Manager System User token with Never (or 60/90 day) expiry.
# See: python scripts/set_whatsapp_token.py --help
WHATSAPP_ACCESS_TOKEN=your-system-user-permanent-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_APP_SECRET=your-app-secret

# Gmail / Google (Gmail + Calendar — re-consent after adding calendar.events)
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token
# Run: python scripts/setup_gmail_oauth.py --credentials path/to/google_creds.json

# GitHub
GITHUB_TOKEN=ghp_your-token
GITHUB_DEFAULT_OWNER=your-github-username

# Azure DevOps (optional)
AZDO_ORG_URL=https://dev.azure.com/your-org
AZDO_PAT=your-pat

# App
DATABASE_URL=sqlite+aiosqlite:///./agent.db
WORKSPACE_DIR=./workspaces
LOG_LEVEL=INFO
ALLOWED_PHONE_NUMBERS=["919876543210"]
