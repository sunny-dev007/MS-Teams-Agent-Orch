# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21
# Optional: dedicated models for planning / PR review (must match Azure AI Foundry deployment names)
AZURE_OPENAI_PLANNING_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_REVIEW_DEPLOYMENT=gpt-4.1
# Comma-separated fallbacks when primary hits rate limits (gpt-4.1, gpt-4o, gpt-4, gpt-5, etc.)
AZURE_OPENAI_FALLBACK_DEPLOYMENTS=gpt-4.1,gpt-4o,gpt-4,gpt-5
AZURE_OPENAI_PLANNING_FALLBACKS=gpt-4.1,gpt-4o,gpt-4,gpt-5
AZURE_OPENAI_REVIEW_FALLBACKS=gpt-4.1,gpt-4o,gpt-4,gpt-5
LLM_MAX_RETRIES_PER_DEPLOYMENT=2
LLM_RETRY_BASE_DELAY_SEC=1.5

# WhatsApp (Meta Cloud API)
WHATSAPP_VERIFY_TOKEN=your-random-verify-token
# IMPORTANT: Do NOT use the temporary ~24h token from Meta API Setup.
# Use a Business Manager System User token with Never (or 60/90 day) expiry.
# See: python scripts/set_whatsapp_token.py --help
WHATSAPP_ACCESS_TOKEN=your-system-user-permanent-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_APP_SECRET=your-app-secret

# Gmail / Google (Gmail + Calendar — re-consent after adding calendar.events)
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token
# Run: python scripts/setup_gmail_oauth.py --credentials path/to/google_creds.json

# GitHub
GITHUB_TOKEN=ghp_your-token
GITHUB_DEFAULT_OWNER=your-github-username

# Azure DevOps (optional)
AZDO_ORG_URL=https://dev.azure.com/your-org
AZDO_PAT=your-pat

# App
DATABASE_URL=sqlite+aiosqlite:///./agent.db
WORKSPACE_DIR=./workspaces
LOG_LEVEL=INFO
ALLOWED_PHONE_NUMBERS=["919876543210"]

# Teams / Copilot Studio channel (optional — WhatsApp keeps working without these)
ENABLE_TEAMS_COPILOT_CHANNEL=true
COPILOT_API_KEY=generate-a-long-random-secret
# Comma-separated AAD object ids or UPNs allowed to call the Copilot tool
ALLOWED_TEAMS_USER_IDS=your-aad-object-id,you@yourdomain.com
# Comma-separated or JSON array. Copilot Studio often sends email/UPN as user_id — include both OID and email.

# Release Agent Fabric (KEEP FALSE on prod until Graph + Playwright are validated)
ENABLE_DOCS_AGENT=false
ENABLE_QA_AGENT=false
ENABLE_RELEASE_HANDOFF=false
# Document Knowledge Fabric (list → ingest/vectorize → RAG QnA → insights)
# KEEP FALSE until Graph list permissions + embedding deployment are validated
ENABLE_DOC_KNOWLEDGE=false
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# Optional OneDrive user (UPN or AAD OID) for app-only listing
MS_GRAPH_ONEDRIVE_USER_ID=
DOC_KNOWLEDGE_SOURCES=sharepoint,onedrive,onenote
DOC_KNOWLEDGE_MAX_LIST=25
# Microsoft Graph app (Docs + Knowledge) — see docs/RELEASE_AGENT_FABRIC_GRAPH_SETUP.md
# and docs/DOCUMENT_KNOWLEDGE_FABRIC.md
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# Prefer site id; or hostname + path:
MS_GRAPH_SHAREPOINT_SITE_ID=
MS_GRAPH_SHAREPOINT_HOSTNAME=contoso.sharepoint.com
MS_GRAPH_SHAREPOINT_SITE_PATH=/sites/Engineering
